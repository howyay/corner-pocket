# Corner Pocket: daily logical backup of the `pool` database (docs/postgres.md).
# Installed as ~/.config/systemd/user/pool-postgres-backup.service; started by the timer.
[Unit]
Description=Corner Pocket PostgreSQL daily backup (pg_dump -Fc, 14-day retention)
Requires=pool-postgres.service
After=pool-postgres.service

[Service]
Type=oneshot
# podman lives in the NixOS system profile; the user manager's PATH may not have it
Environment=PODMAN=/run/current-system/sw/bin/podman
Environment=POOL_BACKUP_DIR=$POOL_PG_ROOT/pool-postgres/backups
Environment=POOL_BACKUP_KEEP_DAYS=14
ExecStart=/home/operator/projects/pool/scripts/pool-postgres-backup.sh dump
UMask=0077
Nice=10

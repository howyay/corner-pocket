# Corner Pocket: daily logical backup of the `pool` database (docs/postgres.md).
# A TEMPLATE: the runbook's install step renders it with sed into
# ~/.config/systemd/user/pool-postgres-backup.service, replacing
#   @REPO_DIR@    the repository checkout
#   @BACKUP_DIR@  the backup directory (must exist, mode 700)
#   @PODMAN@      the podman binary (the user manager's PATH may not have it)
# Started by pool-postgres-backup.timer.
[Unit]
Description=Corner Pocket PostgreSQL daily backup (pg_dump -Fc, 14-day retention)
Requires=pool-postgres.service
After=pool-postgres.service

[Service]
Type=oneshot
Environment=PODMAN=@PODMAN@
Environment=POOL_BACKUP_DIR=@BACKUP_DIR@
Environment=POOL_BACKUP_KEEP_DAYS=14
ExecStart=@REPO_DIR@/scripts/pool-postgres-backup.sh dump
UMask=0077
Nice=10

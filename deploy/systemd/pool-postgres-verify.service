# Corner Pocket: weekly sanity read of the newest backup (pg_restore --list), and a
# loud failure when the newest dump is older than 48 h (the daily backup stopped).
# A TEMPLATE, rendered like pool-postgres-backup.service (@REPO_DIR@, @BACKUP_DIR@, @PODMAN@).
# Started by pool-postgres-verify.timer.
[Unit]
Description=Corner Pocket PostgreSQL backup sanity read (newest dump)
Requires=pool-postgres.service
After=pool-postgres.service

[Service]
Type=oneshot
Environment=PODMAN=@PODMAN@
Environment=POOL_BACKUP_DIR=@BACKUP_DIR@
ExecStart=@REPO_DIR@/scripts/pool-postgres-backup.sh verify
UMask=0077
Nice=10
